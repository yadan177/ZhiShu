{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhishu.dev/schemas/source.schema.json",
  "title": "ZhiShu asset source record",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "tier", "access", "location", "requiredRulepacks"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "tier": { "enum": ["enterprise", "personal", "official"] },
    "access": { "enum": ["local", "git", "github-release"] },
    "location": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,120}$" },
    "readonly": { "type": "boolean" },
    "requiredRulepacks": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/-]*$" },
      "uniqueItems": true
    },
    "hasLocalToken": { "type": "boolean" },
    "maskedToken": { "type": "string" },
    "lastSyncedAt": { "type": "string" },
    "localCheckoutPath": { "type": "string" },
    "availableRulepacks": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
