{
  "name": "zhishu-desktop",
  "version": "2.1.0",
  "private": true,
  "description": "智枢桌面版",
  "main": "build/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "pack:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac dmg --arm64 --publish never",
    "pack:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "electron-updater": "^6.8.9",
    "fflate": "0.8.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.7.0",
    "tar": "^7.5.22",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "cn.zhinao.zhishu",
    "productName": "智枢",
    "buildVersion": "2.1.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/main.cjs",
      "build/preload.cjs",
      "assets/icon.png",
      "assets/icon-mac.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../plugins",
        "to": "plugins",
        "filter": [
          "**/*",
          "!README.md"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "artifactName": "ZhiShu-Desktop-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "dmg": {
      "artifactName": "ZhiShu-Desktop-${version}-macOS-${arch}.dmg"
    }
  }
}
